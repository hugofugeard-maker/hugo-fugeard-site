---
// Version C, "Alpine Evening": a candlelit dinner in a chalet. Dark wood, linen, warm gold.
import Photo from './Photo.astro';
import { emailUrl, getContent, homePath, otherLocale, site, whatsappUrl, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const wa = whatsappUrl(t.contact.whatsappMessage);
const mail = emailUrl(t.contact.emailSubject);
const year = new Date().getFullYear();
---

<header class="header">
  <a class="brand" href={homePath(locale)}>{site.name}</a>
  <nav aria-label="Menu">
    <a href="#about">{t.nav.about}</a>
    <a href="#approach">{t.nav.approach}</a>
    <a href="#offers">{t.nav.offers}</a>
    <a href="#process">{t.nav.process}</a>
    <a href="#faq">{t.nav.faq}</a>
    <a href="#contact">{t.nav.contact}</a>
  </nav>
  <a class="lang" href={homePath(otherLocale(locale))} hreflang={otherLocale(locale)}>{t.nav.language}</a>
</header>

<main id="main">
  <section class="hero">
    <div class="hero-bg">
      <Photo file={t.hero.image} alt={t.hero.imageAlt} sizes="100vw" loading="eager" widths={[800, 1200, 1800, 2400]} />
    </div>
    <div class="hero-content">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.text}</p>
      <div class="buttons">
        <a class="button gold wa" href={wa} target="_blank" rel="noopener">{t.hero.primaryButton}</a>
      </div>
    </div>
  </section>

  <section id="about" class="about light">
    <div class="wrap about-grid">
      <div class="about-photo">
        <Photo file={t.about.image} alt={t.about.imageAlt} sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
      <div>
        <h2>{t.about.title}</h2>
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
        <ul class="values">
          {
            t.about.values.map((v) => (
              <li>
                <span class="ornament" aria-hidden="true">✦</span>
                <div>
                  <strong>{v.title}</strong>
                  <p>{v.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="pull">{t.about.quote}</p>
      </div>
    </div>
  </section>

  <section id="approach" class="approach">
    <div class="wrap">
      <h2>{t.approach.title}</h2>
      <p class="intro">{t.approach.intro}</p>
      <div class="pillars">
        {
          t.approach.items.map((item) => (
            <article>
              <span class="ornament" aria-hidden="true">✦</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="offers" class="offers light">
    <div class="wrap">
      <h2>{t.offers.title}</h2>
      <div class="pillars two">
        {
          t.offers.items.map((item) => (
            <article>
              <span class="ornament" aria-hidden="true">✦</span>
              <h3>{item.title}</h3>
              <p class="places">{item.places}</p>
              <p>{item.text}</p>
              <p class="price">{item.price}</p>
              <div class="buttons">
                <a class="button dark wa" href={whatsappUrl(item.message)} target="_blank" rel="noopener">{item.button}</a>
              </div>
            </article>
          ))
        }
      </div>
      <p class="note">{t.offers.note}</p>
    </div>
  </section>

  <section class="gallery" aria-label={t.gallery.title}>
    <div class="masonry">
      {
        t.gallery.images.map((img) => (
          img.stack ? (
            <figure class="stack">
              {img.stack.map((part) => (
                <Photo file={part.file} alt={part.alt} sizes="(min-width: 900px) 33vw, 100vw" />
              ))}
            </figure>
          ) : (
            <figure>
              <Photo file={img.file} alt={img.alt} sizes="(min-width: 900px) 33vw, 100vw" />
            </figure>
          )
        ))
      }
    </div>
  </section>

  <section id="process" class="process light">
    <div class="wrap">
      <h2>{t.process.title}</h2>
      <p class="intro">{t.process.intro}</p>
      <ol class="timeline">
        {
          t.process.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="faq" class="faq">
    <div class="wrap narrow">
      <h2>{t.faq.title}</h2>
      {
        t.faq.items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section id="partners" class="partners light">
    <div class="wrap narrow">
      <h2>{t.partners.title}</h2>
      <p>{t.partners.text}</p>
      <div class="buttons">
        <a class="button dark wa" href={whatsappUrl(t.partners.whatsappMessage)} target="_blank" rel="noopener">{t.partners.whatsappButton}</a>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="contact-bg">
      <Photo file={t.contact.image} alt={t.contact.imageAlt} sizes="100vw" widths={[800, 1200, 1800, 2400]} />
    </div>
    <div class="wrap narrow">
      <span class="ornament" aria-hidden="true">✦</span>
      <h2>{t.contact.title}</h2>
      <p>{t.contact.text}</p>
      <div class="buttons">
        <a class="button gold wa" href={wa} target="_blank" rel="noopener">{t.contact.whatsappButton}</a>
        <a class="button line" href={mail}>{t.contact.emailButton}</a>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <span>{site.name} · {t.footer.tagline}</span>
  <span>© {year}. {t.footer.rights}</span>
</footer>
